@startuml MetalSlugModelo

class Numero {
    - valor
}

class Juego {
    + Iniciar()
}

class Nivel
class Mision
class Escenario

class HUD
class SistemaFisicas
class SistemaColisiones
class SistemaPuntuacion
class Camara

class MotorGrafico
class MotorSonido

class Personaje {
    - vida : Numero
    + Mover()
    + RecibirDanio(cantidad : Numero)
    + Morir()
}

class Jugador {
    - vidas : Numero
    - granadas : Numero
    - puntaje : Numero
    + Disparar()
    + LanzarGranada()
}

class Enemigo {
    + Atacar()
}

class JefeFinal {
    - vida : Numero
    + AtacarEspecial()
}

class Soldado
class Alien
class Momia
class Rebelde
class Prisionero

class Arma {
    - municion : Numero
    + Disparar()
}

class Pistola
class Ametralladora
class Lanzacohetes
class Escopeta

class Granada {
    - cantidad : Numero
    + Lanzar()
}

class Vehiculo {
    - vida : Numero
    + Mover()
    + Disparar()
}

class MetalSlug
class Tanque
class Helicoptero
class Avion

class Proyectil {
    + Mover()
    + Explotar()
}

class Bala
class Misil
class Explosion

class Item
class PowerUp
class Municion
class VidaExtra
class Tesoro


Jugador --|> Personaje
Enemigo --|> Personaje
JefeFinal --|> Enemigo
Soldado --|> Enemigo
Alien --|> Enemigo
Momia --|> Enemigo
Rebelde --|> Enemigo
Prisionero --|> Personaje

Pistola --|> Arma
Ametralladora --|> Arma
Lanzacohetes --|> Arma
Escopeta --|> Arma

MetalSlug --|> Vehiculo
Tanque --|> Vehiculo
Helicoptero --|> Vehiculo
Avion --|> Vehiculo

Bala --|> Proyectil
Misil --|> Proyectil

PowerUp --|> Item
Municion --|> Item
VidaExtra --|> Item
Tesoro --|> Item


Juego "1" *-- "1..*" Nivel
Nivel "1" *-- "1..*" Mision
Nivel "1" *-- "1" Escenario

Juego "1" o-- "1" Jugador
Jugador "1" o-- "0..1" Arma
Jugador "1" o-- "1..10" Granada
Jugador "1" o-- "0..1" Vehiculo
Jugador "1" o-- "0..1" JefeFinal

Nivel "1" *-- "0..*" Enemigo
Nivel "1" *-- "0..*" Item
Nivel "1" *-- "0..*" Prisionero

Arma "1" *-- "0..*" Proyectil
Proyectil "1" o-- "0..1" Explosion

Juego "1" o-- "1" MotorGrafico
Juego "1" o-- "1" MotorSonido
Juego "1" o-- "1" HUD
Juego "1" o-- "1" Camara

SistemaColisiones "1" o-- "0..*" Personaje
SistemaFisicas "1" o-- "0..*" Personaje
HUD "1" o-- "1" SistemaPuntuacion

@enduml