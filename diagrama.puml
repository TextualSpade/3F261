@startuml

'========================
' CLASES PRINCIPALES
'========================

class Juego
class Nivel
class Mision
class Escenario
class HUD
class SistemaFisicas
class SistemaColisiones
class SistemaPuntuacion
class Camara
class MotorGrafico
class MotorSonido

'========================
' PERSONAJES
'========================

class Personaje {
    vida : int
}

class Jugador {
    vidas : int = 2
    granadas : int
    puntaje : int
}

class Enemigo {
    vida : int
}

class JefeFinal {
    vida : int = 50
}

class Soldado
class Alien
class Momia
class Rebelde

class Prisionero

'========================
' ARMAS
'========================

class Arma {
    municion : int
}

class Pistola {
    municion : int = -1
}

class Ametralladora {
    municion : int = 200
}

class Lanzacohetes {
    municion : int = 30
}

class Escopeta {
    municion : int = 50
}

class Granada {
    cantidad : int
}

'========================
' VEHICULOS
'========================

class Vehiculo {
    vida : int
}

class MetalSlug {
    vida : int = 100
}

class Tanque
class Helicoptero
class Avion

'========================
' OBJETOS
'========================

class Proyectil
class Bala
class Misil
class Explosion

class Item
class PowerUp
class Municion
class VidaExtra
class Tesoro

'========================
' HERENCIA (ES UN)
'========================

Jugador --|> Personaje
Enemigo --|> Personaje
JefeFinal --|> Enemigo
Soldado --|> Enemigo
Alien --|> Enemigo
Momia --|> Enemigo
Rebelde --|> Enemigo
Prisionero --|> Personaje

Pistola --|> Arma
Ametralladora --|> Arma
Lanzacohetes --|> Arma
Escopeta --|> Arma

MetalSlug --|> Vehiculo
Tanque --|> Vehiculo
Helicoptero --|> Vehiculo
Avion --|> Vehiculo

Bala --|> Proyectil
Misil --|> Proyectil

PowerUp --|> Item
Municion --|> Item
VidaExtra --|> Item
Tesoro --|> Item

'========================
' COMPOSICION (TIENE FUERTE)
'========================

Juego "1" *-- "1" Nivel
Juego "1" *-- "1" HUD
Juego "1" *-- "1" SistemaFisicas
Juego "1" *-- "1" SistemaColisiones
Juego "1" *-- "1" SistemaPuntuacion
Juego "1" *-- "1" Camara

Nivel "1" *-- "1..*" Mision
Nivel "1" *-- "1" Escenario

Arma "1" *-- "0..*" Proyectil

'========================
' AGREGACION (TIENE DEBIL)
'========================

Jugador "1" o-- "1" Arma
Jugador "1" o-- "0..*" Granada
Jugador "1" o-- "0..1" Vehiculo

Enemigo "1" o-- "0..1" Arma

Nivel "1" o-- "1..*" Enemigo
Nivel "1" o-- "0..*" Item
Nivel "1" o-- "0..*" Prisionero

'========================
' DEPENDENCIAS (USA)
'========================

Juego ..> MotorGrafico
Juego ..> MotorSonido

Jugador ..> Arma
Jugador ..> Vehiculo
Jugador ..> Item

Arma ..> Proyectil
Proyectil ..> Explosion

SistemaColisiones ..> Personaje
SistemaColisiones ..> Proyectil
SistemaColisiones ..> Vehiculo

SistemaFisicas ..> Personaje
SistemaFisicas ..> Vehiculo

HUD ..> SistemaPuntuacion
SistemaPuntuacion ..> Enemigo

@enduml