@startuml

'========================
' CLASES PRINCIPALES
'========================

class Juego {
    + iniciar()
}

class Nivel
class Mision
class Escenario

class HUD
class SistemaFisicas
class SistemaColisiones
class SistemaPuntuacion
class Camara

class MotorGrafico
class MotorSonido

'========================
' PERSONAJES
'========================

class Personaje {
    vida : int
    + mover()
    + recibirDanio(cantidad : int)
    + morir()
}

class Jugador {
    vidas : int = 2
    granadas : int
    puntaje : int
    + disparar()
    + lanzarGranada()
}

class Enemigo {
    vida : int
    + atacar()
}

class JefeFinal {
    vida : int = 50
    + ataqueEspecial()
}

class Soldado
class Alien
class Momia
class Rebelde
class Prisionero

'========================
' ARMAS
'========================

class Arma {
    municion : int
    + disparar()
}

class Pistola {
    municion : int = -1
}

class Ametralladora {
    municion : int = 200
}

class Lanzacohetes {
    municion : int = 30
}

class Escopeta {
    municion : int = 50
}

class Granada {
    cantidad : int
    + lanzar()
}

'========================
' VEHICULOS
'========================

class Vehiculo {
    vida : int
    + mover()
    + disparar()
}

class MetalSlug {
    vida : int = 100
}

class Tanque
class Helicoptero
class Avion

'========================
' OBJETOS
'========================

class Proyectil {
    + mover()
    + explotar()
}

class Bala
class Misil
class Explosion

class Item
class PowerUp
class Municion
class VidaExtra
class Tesoro

'========================
' ES UN (HERENCIA)
'========================

Jugador --|> Personaje
Enemigo --|> Personaje
JefeFinal --|> Enemigo
Soldado --|> Enemigo
Alien --|> Enemigo
Momia --|> Enemigo
Rebelde --|> Enemigo
Prisionero --|> Personaje

Pistola --|> Arma
Ametralladora --|> Arma
Lanzacohetes --|> Arma
Escopeta --|> Arma

MetalSlug --|> Vehiculo
Tanque --|> Vehiculo
Helicoptero --|> Vehiculo
Avion --|> Vehiculo

Bala --|> Proyectil
Misil --|> Proyectil

PowerUp --|> Item
Municion --|> Item
VidaExtra --|> Item
Tesoro --|> Item

'========================
' TIENE (COMPOSICION Y AGREGACION)
'========================

Juego *-- Nivel
Nivel *-- Mision
Nivel *-- Escenario

Juego o-- Jugador
Jugador o-- Arma
Jugador o-- Granada
Jugador o-- Vehiculo

Nivel o-- Enemigo
Nivel o-- Item
Nivel o-- Prisionero

Arma *-- Proyectil

'========================
' USA (DEPENDENCIAS)
'========================

Juego ..> MotorGrafico
Juego ..> MotorSonido

Jugador ..> Arma
Jugador ..> Vehiculo

Arma ..> Proyectil
Proyectil ..> Explosion

SistemaColisiones ..> Personaje
SistemaFisicas ..> Personaje
HUD ..> SistemaPuntuacion

@enduml