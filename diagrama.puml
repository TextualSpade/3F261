@startuml
@startuml MetalSlugModelo

class Numero {
    - valor
}

class Juego {
    + Iniciar()
}

class Nivel
class Mision
class Escenario

class HUD
class SistemaFisicas
class SistemaColisiones
class SistemaPuntuacion
class Camara

class MotorGrafico
class MotorSonido

class Personaje {
    - vida : Numero
    + Mover()
    + RecibirDanio(cantidad : Numero)
    + Morir()
}

class Jugador {
    - vidas : Numero
    - granadas : Numero
    - puntaje : Numero
    + Disparar()
    + LanzarGranada()
}

class Enemigo {
    + Atacar()
}

class JefeFinal {
    - vida : Numero
    + AtacarEspecial()
}

class Soldado
class Alien
class Momia
class Rebelde
class Prisionero

class Arma {
    - municion : Numero
    + Disparar()
}

class Pistola
class Ametralladora
class Lanzacohetes
class Escopeta

class Granada {
    - cantidad : Numero
    + Lanzar()
}

class Vehiculo {
    - vida : Numero
    + Mover()
    + Disparar()
}

class MetalSlug
class Tanque
class Helicoptero
class Avion

class Proyectil {
    + Mover()
    + Explotar()
}

class Bala
class Misil
class Explosion

class Item
class PowerUp
class Municion
class VidaExtra
class Tesoro

Jugador --|> Personaje
Enemigo --|> Personaje
JefeFinal --|> Enemigo
Soldado --|> Enemigo
Alien --|> Enemigo
Momia --|> Enemigo
Rebelde --|> Enemigo
Prisionero --|> Personaje

Pistola --|> Arma
Ametralladora --|> Arma
Lanzacohetes --|> Arma
Escopeta --|> Arma

MetalSlug --|> Vehiculo
Tanque --|> Vehiculo
Helicoptero --|> Vehiculo
Avion --|> Vehiculo

Bala --|> Proyectil
Misil --|> Proyectil

PowerUp --|> Item
Municion --|> Item
VidaExtra --|> Item
Tesoro --|> Item

Juego *-- Nivel
Nivel *-- Mision
Nivel *-- Escenario

Juego o-- Jugador
Jugador o-- Arma
Jugador o-- Granada
Jugador o-- Vehiculo

Nivel o-- Enemigo
Nivel o-- Item
Nivel o-- Prisionero

Arma *-- Proyectil
Proyectil o-- Explosion

Juego o-- MotorGrafico
Juego o-- MotorSonido

SistemaColisiones o-- Personaje
SistemaFisicas o-- Personaje
HUD o-- SistemaPuntuacion

@enduml
@enduml