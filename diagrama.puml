@startuml

'========================
' INTERFACES
'========================

interface IVida {
    + recibirDanio(cantidad : int) : void
    + estaVivo() : boolean
    + morir() : void
}

interface IMenu {
    + mostrarMenu() : void
    + iniciarJuego() : void
    + salir() : void
}

'========================
' CLASES PRINCIPALES
'========================

class Juego {
    - activo : boolean
    + iniciar() : void
    + actualizar() : void
    + terminar() : void
}

class Nivel {
    - numero : int
    + cargar() : void
    + finalizar() : void
}

class HUD {
    + mostrarVida(vida : int) : void
    + mostrarMunicion(municion : int) : void
    + mostrarPuntaje(puntos : int) : void
}

class SistemaFisicas {
    + aplicarGravedad() : void
}

class SistemaColisiones {
    + detectarColision() : boolean
    + aplicarDanio(objetivo : IVida, cantidad : int) : void
}

class SistemaPuntuacion {
    - puntos : int
    + sumarPuntos(cantidad : int) : void
    + obtenerPuntos() : int
}

class Camara {
    + seguirJugador(jugador : Jugador) : void
}

class MotorGrafico {
    + dibujar() : void
}

class MotorSonido {
    + reproducirSonido(nombre : String) : void
}

'========================
' PERSONAJES
'========================

class Personaje {
    - vida : int
    - posicionX : int
    - posicionY : int
    + mover(dx : int, dy : int) : void
    + saltar() : void
    + recibirDanio(cantidad : int) : void
    + estaVivo() : boolean
    + morir() : void
}

class Jugador {
    - granadas : int
    - puntaje : int
    + disparar() : void
    + lanzarGranada() : void
}

class Enemigo {
    + atacar() : void
}

class JefeFinal {
    + ataqueEspecial() : void
}

class Soldado
class Alien
class Momia
class Rebelde
class Prisionero

'========================
' ARMAS
'========================

class Arma {
    - municion : int
    + disparar() : void
    + recargar(cantidad : int) : void
}

class Pistola
class Ametralladora
class Lanzacohetes
class Escopeta

class Granada {
    - cantidad : int
    + lanzar() : void
}

'========================
' VEHICULOS
'========================

class Vehiculo {
    - vida : int
    + mover(dx : int, dy : int) : void
    + disparar() : void
    + recibirDanio(cantidad : int) : void
    + estaVivo() : boolean
    + morir() : void
}

class MetalSlug
class Tanque
class Helicoptero
class Avion

'========================
' OBJETOS
'========================

class Proyectil {
    - velocidad : int
    - danio : int
    + mover() : void
}

class Bala
class Misil

class Explosion {
    + explotar() : void
}

class Item {
    + aplicarEfecto(jugador : Jugador) : void
}

class PowerUp
class Municion
class VidaExtra
class Tesoro

'========================
' HERENCIA (ES UN)
'========================

Jugador --|> Personaje
Enemigo --|> Personaje
JefeFinal --|> Enemigo
Soldado --|> Enemigo
Alien --|> Enemigo
Momia --|> Enemigo
Rebelde --|> Enemigo
Prisionero --|> Personaje

Pistola --|> Arma
Ametralladora --|> Arma
Lanzacohetes --|> Arma
Escopeta --|> Arma

MetalSlug --|> Vehiculo
Tanque --|> Vehiculo
Helicoptero --|> Vehiculo
Avion --|> Vehiculo

Bala --|> Proyectil
Misil --|> Proyectil

PowerUp --|> Item
Municion --|> Item
VidaExtra --|> Item
Tesoro --|> Item

'========================
' IMPLEMENTACION INTERFACES
'========================

Personaje ..|> IVida
Vehiculo ..|> IVida
Juego ..|> IMenu

'========================
' COMPOSICION (TIENE FUERTE)
'========================

Juego *-- Nivel
Juego *-- HUD
Juego *-- SistemaFisicas
Juego *-- SistemaColisiones
Juego *-- SistemaPuntuacion
Juego *-- Camara

Nivel *-- Escenario

Arma *-- Proyectil

'========================
' AGREGACION (TIENE DEBIL)
'========================

Juego "1" o-- "1" Jugador
Jugador o-- Arma
Jugador o-- Granada
Jugador o-- Vehiculo

Nivel o-- Enemigo
Nivel o-- Item
Nivel o-- Prisionero

'========================
' DEPENDENCIAS (USA)
'========================

Juego ..> MotorGrafico
Juego ..> MotorSonido

SistemaColisiones ..> IVida
SistemaColisiones ..> Proyectil

Arma ..> Proyectil
Proyectil ..> Explosion

SistemaFisicas ..> Personaje
SistemaFisicas ..> Vehiculo

HUD ..> SistemaPuntuacion

@enduml